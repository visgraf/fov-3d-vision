# Regenerable: if a command made it, the command is the artifact.
# Every path below is rebuilt by a command in docs/a1-scene-gathering.md.
previews/
out/
*.part
.venv/
__pycache__/

# Scenes: assets and generated files stay out, provenance stays in
# (scenes/manifest.json and each download's scenes/hdri/<slug>/asset.json).
# Downloads are pinned so they come back byte-identical: the HDRI by the md5 in its
# asset.json, Classroom by the URL in the manifest. workshop_8k.exr alone is 324 MB
# against GitHub's 100 MB per-file limit.
*.blend
*.blend1
*.exr
*.hdr
*.zip
scenes/**/*.targets.json
scenes/classroom/

# docs/reference/ is committed on purpose: those images are the CPU baseline.
